# Copy to .env or set these in your shell. All are OPTIONAL; defaults are shown.
# Never commit real values.

# Secret used to sign login tokens. If unset, a random key is generated once and stored in instance/secret.key.
WATER_JWT_SECRET=

# Where the SQLite database, uploaded files and the generated key live (default: ./instance)
WATER_DATA_STORE=./instance

# Use a specific trained run folder under outputs/ (default: newest billing-period run)
WATER_RUN_ID=

# Other locations (defaults relative to the project)
WATER_OUTPUTS_DIR=./outputs
WATER_ORIGINAL_DATASET=./data/kharghar_period_totals.csv

# Limits and sessions
WATER_MAX_UPLOAD_MB=5
WATER_MAX_UPLOAD_ROWS=5000
WATER_TOKEN_HOURS=8

# Only used when creating the first admin non-interactively (otherwise you are prompted)
WATER_ADMIN_PASSWORD=
